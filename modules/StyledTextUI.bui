Private Function RichMacOwner(receiver As Ptr) As StyledTextEditor
    For Each item As RichOwner In RichRegistry.Items
        Dim owner As StyledTextEditor = item.Editor
        If owner <> Nil Then
            If owner.TextHandle = receiver Then Return owner
        End If
    Next
    Return Nil
End Function
Private Function RichMacClass() As Ptr
    Dim cls As Ptr = MClass("BuoyStyledTextEditorV1")
    If cls <> Nil Then Return cls
    cls = MAllocateClass(MClass("NSTextView"), "BuoyStyledTextEditorV1", 0)
    If cls = Nil Then Throw New Exception("Could not allocate NSTextView subclass")
    Dim changed As RichMacAction = AddressOf RichMacChanged
    Dim selection As RichMacAction = AddressOf RichMacSelection
    Dim key As RichMacAction = AddressOf RichMacKey
    Dim editing As RichMacEdit = AddressOf RichMacEditing
    If MAddMethod(cls, MSelector("textDidChange:"), CType(changed, Ptr), "v@:@") = 0 Then Throw New Exception("Could not register text delegate")
    If MAddMethod(cls, MSelector("textViewDidChangeSelection:"), CType(selection, Ptr), "v@:@") = 0 Then Throw New Exception("Could not register selection delegate")
    If MAddMethod(cls, MSelector("keyDown:"), CType(key, Ptr), "v@:@") = 0 Then Throw New Exception("Could not register keyboard handler")
    Dim editEncoding As String = "c@:@{_NSRange=QQ}@"
    #If TargetArm Then
        editEncoding = "B@:@{_NSRange=QQ}@"
    #End If
    If MAddMethod(cls, MSelector("textView:shouldChangeTextInRange:replacementString:"), CType(editing, Ptr), editEncoding) = 0 Then Throw New Exception("Could not register editing delegate")
    MRegisterClass(cls)
    Return cls
End Function
Private Class RichMacCleanupTarget
    Public Shared Property Target As Ptr = Nil
End Class
Private Declare Sub MPerformLater Lib "Foundation" Selector "performSelector:withObject:afterDelay:" (target As Ptr, actionSelector As Ptr, argument As Ptr, delay As Double)
Private Sub RichNativeScheduleCleanup()
    If RichMacCleanupTarget.Target = Nil Then
        Dim cls As Ptr = MClass("BuoyStyledEditorCleanupV1")
        If cls = Nil Then
            cls = MAllocateClass(MClass("NSObject"), "BuoyStyledEditorCleanupV1", 0)
            If cls = Nil Then Throw New Exception("Could not allocate editor cleanup target")
            Dim callback As RichMacAction = AddressOf RichMacDrain
            If MAddMethod(cls, MSelector("drainEditors:"), CType(callback, Ptr), "v@:@") = 0 Then Throw New Exception("Could not register editor cleanup")
            MRegisterClass(cls)
        End If
        RichMacCleanupTarget.Target = MNew(cls)
    End If
    MPerformLater(RichMacCleanupTarget.Target, MSelector("drainEditors:"), Nil, 0.0)
End Sub
Private Sub RichMacDrain(receiver As Ptr, actionSelector As Ptr, argument As Ptr)
    RichDrainClosed()
End Sub

Private Sub RichNativeOpen(state As RichState)
    Dim frame As RichRect = { X: 0.0, Y: 0.0, Width: 320.0, Height: 240.0 }
    state.Root = MInitFrame(MAlloc(MClass("NSScrollView")), frame)
    state.Entry = MInitFrame(MAlloc(RichMacClass()), frame)
    If state.Root = Nil Or state.Entry = Nil Then Throw New Exception("Could not create AppKit rich-text editor")
    MRich(state.Entry, True)
    MBackground(state.Entry, MWhite(MClass("NSColor")))
    MCaretColor(state.Entry, MBlack(MClass("NSColor")))
    MAllowsUndo(state.Entry, False)
    MVerticalResize(state.Entry, True)
    MHorizontalResize(state.Entry, False)
    Dim maxSize As RichSize = { Width: 10000000.0, Height: 10000000.0 }
    MMaxSize(state.Entry, maxSize)
    MTracksWidth(MTextContainer(state.Entry), True)
    MAutoresizing(state.Entry, 2)
    MDelegate(state.Entry, state.Entry)
    MDocumentView(state.Root, state.Entry)
    MVerticalScroll(state.Root, True)
    MHorizontalScroll(state.Root, False)
    MAutoresizing(state.Root, 18)
    MAddSubview(state.Host, state.Root)
    state.Buffer = MStorage(state.Entry)
End Sub
Private Sub RichNativeDispose(state As RichState)
    If state.Entry <> Nil Then MDelegate(state.Entry, Nil)
    If state.Root <> Nil Then
        MDocumentView(state.Root, Nil)
        MRemove(state.Root)
    End If
    If state.Entry <> Nil Then MRelease(state.Entry)
    If state.Root <> Nil Then MRelease(state.Root)
    state.Entry = Nil
    state.Root = Nil
    state.Buffer = Nil
End Sub
Private Sub RichNativeSize(state As RichState, width As Integer, height As Integer)
    Dim frame As RichRect = { X: 0.0, Y: 0.0, Width: Math.Max(1, width), Height: Math.Max(1, height) }
    MFrame(state.Root, frame)
End Sub
Private Sub RichNativeFocus(state As RichState)
    MResponder(MWindow(state.Entry), state.Entry)
End Sub
Private Sub RichNativeEditable(state As RichState, enabled As Boolean)
    MEditable(state.Entry, enabled)
End Sub
Private Function RichNativeRead(state As RichState) As String
    Dim content As Ptr = MText(state.Entry)
    If MTextLength(content) > 200000 Then Throw New InvalidArgumentException("Native text exceeds editor limit")
    Return MUTF8(content)
End Function
Private Sub RichNativeWrite(state As RichState, content As String)
    Dim native As CFStringRef = CType(content, CFStringRef)
    Try
        MSetText(state.Entry, native)
    Finally
        MRelease(native)
    End Try
End Sub
Private Function RichNativeSelection(state As RichState, content As String) As RichSelection
    Dim range As RichRange = MSelection(state.Entry)
    Dim offsets As Array Of Integer = RichOffsets(content)
    Dim selection As New RichSelection()
    selection.Start = RichScalarAt(offsets, range.Location)
    selection.Length = RichScalarAt(offsets, range.Location + range.Length) - selection.Start
    Return selection
End Function
Private Sub RichNativeSelect(state As RichState, content As String, start As Integer, length As Integer)
    Dim offsets As Array Of Integer = RichOffsets(content)
    Dim range As RichRange = { Location: offsets(start), Length: offsets(start + length) - offsets(start) }
    MSelect(state.Entry, range)
End Sub
Private Sub RichMacAttribute(dict As Ptr, key As String, value As Ptr)
    Dim nativeKey As CFStringRef = CType(key, CFStringRef)
    Try
        MSetAttribute(dict, value, nativeKey)
    Finally
        MRelease(nativeKey)
    End Try
End Sub
Private Function RichMacAttributes(style As TextStyle) As Ptr
    Dim size As Double = style.FontSize
    If size = 0.0 Then size = 12.0
    Dim font As Ptr = Nil
    If style.FontName <> "" Then
        Dim name As CFStringRef = CType(style.FontName, CFStringRef)
        font = MFontNamed(MClass("NSFont"), name, size)
        MRelease(name)
    End If
    If font = Nil Then font = MSystemFont(MClass("NSFont"), size)
    Dim manager As Ptr = MFontManager(MClass("NSFontManager"))
    If style.Bold Then
        font = MFontTrait(manager, font, 2)
    Else
        font = MFontNoTrait(manager, font, 2)
    End If
    If style.Italic Then
        font = MFontTrait(manager, font, 1)
    Else
        font = MFontNoTrait(manager, font, 1)
    End If
    Dim attributes As Ptr = MNew(MClass("NSMutableDictionary"))
    RichMacAttribute(attributes, "NSFont", font)
    RichMacAttribute(attributes, "NSColor", MColor(MClass("NSColor"), style.Red / 65535.0, style.Green / 65535.0, style.Blue / 65535.0, 1.0))
    Dim underline As Integer = 0
    If style.Underline Then underline = 1
    RichMacAttribute(attributes, "NSUnderline", MInteger(MClass("NSNumber"), underline))
    Return attributes
End Function
Private Sub RichNativeTyping(state As RichState, style As TextStyle)
    Dim pool As Ptr = MNew(MClass("NSAutoreleasePool"))
    Dim attributes As Ptr = RichMacAttributes(style)
    Try
        MTyping(state.Entry, attributes)
    Finally
        MRelease(attributes)
        MDrain(pool)
    End Try
End Sub
Private Sub RichNativeRender(state As RichState, document As StyledText)
    Dim pool As Ptr = MNew(MClass("NSAutoreleasePool"))
    Dim offsets As Array Of Integer = RichOffsets(document.PlainText())
    MBegin(state.Buffer)
    Try
        For Each run As StyleRun In document.Runs()
            Dim attributes As Ptr = RichMacAttributes(run.Style)
            Try
                Dim range As RichRange = { Location: offsets(run.Start), Length: offsets(run.Start + run.Length) - offsets(run.Start) }
                MAttributes(state.Buffer, attributes, range)
            Finally
                MRelease(attributes)
            End Try
        Next
    Finally
        MEnd(state.Buffer)
        MDrain(pool)
    End Try
End Sub
Private Sub RichMacChanged(receiver As Ptr, actionSelector As Ptr, sender As Ptr)
    Dim owner As StyledTextEditor = RichMacOwner(receiver)
    If owner <> Nil Then owner.NativeChanged(receiver)
End Sub
Private Sub RichMacSelection(receiver As Ptr, actionSelector As Ptr, sender As Ptr)
    Dim owner As StyledTextEditor = RichMacOwner(receiver)
    If owner <> Nil Then owner.NativeSelectionChanged(receiver)
End Sub
Private Function RichMacEditing(receiver As Ptr, actionSelector As Ptr, view As Ptr, range As RichRange, replacement As Ptr) As UInt8
    Dim owner As StyledTextEditor = RichMacOwner(receiver)
    If owner Is Nil Then Return 1
    Try
        If replacement = Nil Then Return 1
        If range.Length = 0 And MTextLength(replacement) = 0 Then Return 1
        Dim offsets As Array Of Integer = RichOffsets(owner.Document().PlainText())
        Dim start As Integer = RichScalarAt(offsets, range.Location)
        Dim finish As Integer = RichScalarAt(offsets, range.Location + range.Length)
        If MTextLength(replacement) > 200000 Then Return 0
        Dim content As String = MUTF8(replacement)
        If content.AsUTF16LE().Count \ 2 <> MTextLength(replacement) Then Return 0
        If String.Contains(content, "\r") Then
            content = String.Replace(String.Replace(content, "\r\n", "\n"), "\r", "\n")
            owner.NativeNormalizedEdit(start, finish - start, content)
            Return 0
        End If
        If Not owner.NativeAcceptEdit(start, finish - start, content) Then Return 0
        owner.NativeWillEdit(start, finish - start)
        Return 1
    Catch e As Exception
        owner.LastNativeError = e.Message
        Return 0
    End Try
End Function
Private Sub RichMacKey(receiver As Ptr, actionSelector As Ptr, nativeEvent As Ptr)
    Dim owner As StyledTextEditor = RichMacOwner(receiver)
    If owner <> Nil Then
        Try
            Dim modifiers As Integer = MModifiers(nativeEvent)
            If (modifiers And 1048576) <> 0 And (modifiers And 524288) = 0 Then
                Dim key As String = MUTF8(MKey(nativeEvent))
                If String.Len(key) = 1 Then
                    If owner.NativeShortcut(String.Asc(key), (modifiers And 131072) <> 0) Then Return
                End If
            End If
        Catch e As Exception
            owner.LastNativeError = e.Message
        End Try
    End If
    Dim parent As RichSuper = { Receiver: receiver, Parent: MClass("NSTextView") }
    MSuperKey(parent, actionSelector, nativeEvent)
    If owner <> Nil Then owner.NativeEditFinished()
End Sub
#End If

#If TargetWindows Then
Sequential Structure RichWinRange
    Start As Int32
    Finish As Int32
End Structure
Sequential Structure RichWinHeader
    Window As Ptr
    ID As UInt64
    Code As UInt32
End Structure
Private Class RichWindowsLibrary
    Public Shared Property ModuleHandle As Ptr = Nil
End Class
Private Delegate Function RichWindowsCallback(widget As Ptr, message As UInt32, word As UInt64, param As Integer, id As Integer, data As UInt64) As Int64
Private Optional Declare Function WLoad Lib "kernel32" Alias "LoadLibraryW" (name As Ptr) As Ptr
Private Optional Declare Function WCreate Lib "user32" Alias "CreateWindowExW" (extended As UInt32, cls As Ptr, title As Ptr, style As UInt32, x As Int32, y As Int32, width As Int32, height As Int32, parent As Ptr, menu As Ptr, instance As Ptr, creation As Ptr) As Ptr
Private Optional Declare Function WSubclass Lib "comctl32" Alias "SetWindowSubclass" (widget As Ptr, callback As RichWindowsCallback, id As Integer, data As UInt64) As Int32
Private Optional Declare Function WUnsubclass Lib "comctl32" Alias "RemoveWindowSubclass" (widget As Ptr, callback As RichWindowsCallback, id As Integer) As Int32
Private Optional Declare Function WDefault Lib "comctl32" Alias "DefSubclassProc" (widget As Ptr, message As UInt32, word As UInt64, param As Integer) As Int64
Private Optional Declare Function WSend Lib "user32" Alias "SendMessageW" (widget As Ptr, message As UInt32, word As UInt64, param As Integer) As Int64
Private Optional Declare Function WSetText Lib "user32" Alias "SetWindowTextW" (widget As Ptr, content As Ptr) As Int32
Private Optional Declare Function WDestroy Lib "user32" Alias "DestroyWindow" (widget As Ptr) As Int32
Private Optional Declare Function WIsWindow Lib "user32" Alias "IsWindow" (widget As Ptr) As Int32
Private Optional Declare Function WMove Lib "user32" Alias "MoveWindow" (widget As Ptr, x As Int32, y As Int32, width As Int32, height As Int32, repaint As Int32) As Int32
Private Optional Declare Function WDPI Lib "user32" Alias "GetDpiForWindow" (widget As Ptr) As UInt32
Private Optional Declare Function WFocus Lib "user32" Alias "SetFocus" (widget As Ptr) As Ptr
Private Optional Declare Function WKeyState Lib "user32" Alias "GetKeyState" (key As Int32) As Int16
Private Optional Declare Sub WHeader Lib "msvcrt" Alias "memcpy" (ByRef header As RichWinHeader, source As Ptr, count As UInt64)

Private Function RichWide(content As String) As Bytes
    Dim data As Bytes = content.AsUTF16LE()
    data.Append(0)
    data.Append(0)
    Return data
End Function
Private Sub RichLittle(data As Bytes, offset As Integer, value As Integer)
    For i As Integer = 0 To 3
        data.SetItem(offset + i, value Mod 256)
        value = value \ 256
    Next
End Sub
Private Function RichWinBuffer(count As Integer) As Bytes
    Dim data As New Bytes()
    For i As Integer = 1 To count
        data.Append(0)
    Next
    Return data
End Function
Private Function RichReadLittle(data As Bytes, offset As Integer) As Integer
    Return data.Item(offset) + data.Item(offset + 1) * 256 + data.Item(offset + 2) * 65536 + data.Item(offset + 3) * 16777216
End Function
Private Function RichWinReadRange(entry As Ptr) As RichWinRange
    Dim data As Bytes = RichWinBuffer(8)
    WSend(entry, 1076, 0, CType(data.DataPtr(), Integer))
    Dim range As RichWinRange = { Start: RichReadLittle(data, 0), Finish: RichReadLittle(data, 4) }
    Return range
End Function
Private Sub RichWinSetRange(entry As Ptr, first As Integer, last As Integer)
    Dim data As Bytes = RichWinBuffer(8)
    RichLittle(data, 0, first)
    RichLittle(data, 4, last)
    WSend(entry, 1079, 0, CType(data.DataPtr(), Integer))
End Sub
Private Function RichWinFormat(style As TextStyle) As Bytes
    Dim data As New Bytes()
    For i As Integer = 0 To 115
        data.Append(0)
    Next
    RichLittle(data, 0, 116)
    RichLittle(data, 4, 4294967295)
    Dim effects As Integer = 0
    If style.Bold Then effects += 1
    If style.Italic Then effects += 2
    If style.Underline Then effects += 4
    RichLittle(data, 8, effects)
    Dim weight As Integer = 400
    If style.Bold Then weight = 700
    data.SetItem(90, weight Mod 256)
    data.SetItem(91, weight \ 256)
    RichLittle(data, 96, 16777215)
    If style.Underline Then data.SetItem(112, 1)
    Dim size As Double = style.FontSize
    If size = 0.0 Then size = 12.0
    Dim twips As Integer = size * 20.0 + 0.5
    RichLittle(data, 12, twips)
    RichLittle(data, 20, (style.Red \ 257) + (style.Green \ 257) * 256 + (style.Blue \ 257) * 65536)
    data.SetItem(24, 1)
    Dim family As String = style.FontName
    If family = "" Then family = "Segoe UI"
    Dim name As Bytes = family.AsUTF16LE()
    For i As Integer = 0 To name.Count - 1
        data.SetItem(26 + i, name.Item(i))
    Next
    Return data
End Function
Private Delegate Sub RichWindowsTimer(widget As Ptr, message As UInt32, id As UInt64, ticks As UInt32)
Private Optional Declare Function WCleanupTimer Lib "user32" Alias "SetTimer" (widget As Ptr, id As UInt64, interval As UInt32, callback As RichWindowsTimer) As UInt64
Private Optional Declare Function WKillTimer Lib "user32" Alias "KillTimer" (widget As Ptr, id As UInt64) As Int32
Private Sub RichNativeScheduleCleanup()
    If WCleanupTimer(Nil, 0, 1, AddressOf RichWindowsDrain) = 0 Then Throw New Exception("Could not schedule Windows editor cleanup")
End Sub
Private Sub RichWindowsDrain(widget As Ptr, message As UInt32, id As UInt64, ticks As UInt32)
    WKillTimer(Nil, id)
    RichDrainClosed()
End Sub

Private Sub RichNativeOpen(state As RichState)
    If WIsWindow(state.Host) = 0 Then Throw New InvalidArgumentException("Attach editor to a live window before Open")
    If RichWindowsLibrary.ModuleHandle = Nil Then
        Dim dll As Bytes = RichWide("Msftedit.dll")
        RichWindowsLibrary.ModuleHandle = WLoad(dll.DataPtr())
    End If
    If RichWindowsLibrary.ModuleHandle = Nil Then Throw New UnsupportedOperationException("Windows Rich Edit is unavailable")
    Dim cls As Bytes = RichWide("RICHEDIT50W")
    state.Entry = WCreate(512, cls.DataPtr(), Nil, 1344344132, 0, 0, 1, 1, state.Host, Nil, Nil, Nil)
    If state.Entry = Nil Then Throw New Exception("Could not create Windows Rich Edit")
    state.Root = state.Entry
    state.Buffer = state.Entry
    If WSubclass(state.Host, AddressOf RichWindowsHost, state.ID + 1, 0) = 0 Then Throw New Exception("Could not subclass rich-text host")
    If WSubclass(state.Entry, AddressOf RichWindowsEntry, state.ID + 1, 0) = 0 Then Throw New Exception("Could not subclass Rich Edit")
    WSend(state.Entry, 1093, 0, 524289)
    WSend(state.Entry, 1106, 0, 0)
    WSend(state.Entry, 1077, 0, 200000)
    WSend(state.Entry, 1115, 0, 0)
    WSend(state.Entry, 1091, 0, 16777215)
End Sub
Private Sub RichNativeDispose(state As RichState)
    If state.Host <> Nil Then
        If WIsWindow(state.Host) <> 0 Then WUnsubclass(state.Host, AddressOf RichWindowsHost, state.ID + 1)
    End If
    If state.Entry <> Nil Then
        If WIsWindow(state.Entry) <> 0 Then
            WUnsubclass(state.Entry, AddressOf RichWindowsEntry, state.ID + 1)
            WDestroy(state.Entry)
        End If
    End If
    state.Root = Nil
    state.Entry = Nil
    state.Buffer = Nil
End Sub
Private Sub RichNativeSize(state As RichState, width As Integer, height As Integer)
    Dim dpi As Integer = 96
    Try
        dpi = WDPI(state.Host)
    Catch e As LibraryUnavailableException
        dpi = 96
    End Try
    If dpi <= 0 Then dpi = 96
    Dim scale As Double = dpi / 96.0
    WMove(state.Entry, 0, 0, Math.Max(1, width * scale), Math.Max(1, height * scale), 1)
End Sub
Private Sub RichNativeFocus(state As RichState)
    WFocus(state.Entry)
End Sub
Private Sub RichNativeEditable(state As RichState, enabled As Boolean)
    Dim readOnlyValue As UInt64 = 1
    If enabled Then readOnlyValue = 0
    WSend(state.Entry, 207, readOnlyValue, 0)
End Sub
Private Function RichNativeRead(state As RichState) As String
    Dim lengthRequest As Bytes = RichWinBuffer(8)
    RichLittle(lengthRequest, 0, 10)
    RichLittle(lengthRequest, 4, 1200)
    Dim length As Integer = WSend(state.Entry, 1119, CType(lengthRequest.DataPtr(), Integer), 0)
    If length < 0 Or length > 200000 Then Throw New InvalidArgumentException("Native text exceeds editor limit")
    Dim data As New Bytes()
    For i As Integer = 0 To (length + 1) * 2 - 1
        data.Append(0)
    Next
    Dim request As Bytes = RichWinBuffer(32)
    RichLittle(request, 0, data.Count)
    RichLittle(request, 8, 1200)
    Dim copied As Integer = WSend(state.Entry, 1118, CType(request.DataPtr(), Integer), CType(data.DataPtr(), Integer))
    If copied < 0 Or copied > length Then Throw New Exception("Could not read Rich Edit content")
    Dim content As New Bytes()
    content.Append(data.DataPtr(), copied * 2)
    Return String.Replace(content.ToString(Text.Encodings.UTF16LE), "\r", "\n")
End Function
Private Sub RichNativeWrite(state As RichState, content As String)
    Dim data As Bytes = RichWide(content)
    If WSetText(state.Entry, data.DataPtr()) = 0 Then Throw New Exception("Could not replace Rich Edit content")
End Sub
Private Function RichNativeSelection(state As RichState, content As String) As RichSelection
    Dim range As RichWinRange = RichWinReadRange(state.Entry)
    Dim offsets As Array Of Integer = RichOffsets(content)
    Dim selection As New RichSelection()
    selection.Start = RichScalarAt(offsets, range.Start)
    selection.Length = RichScalarAt(offsets, range.Finish) - selection.Start
    Return selection
End Function
Private Sub RichNativeSelect(state As RichState, content As String, start As Integer, length As Integer)
    Dim offsets As Array Of Integer = RichOffsets(content)
    RichWinSetRange(state.Entry, offsets(start), offsets(start + length))
End Sub
Private Sub RichNativeTyping(state As RichState, style As TextStyle)
    Dim selection As RichWinRange = RichWinReadRange(state.Entry)
    If selection.Start <> selection.Finish Then Return
    Dim data As Bytes = RichWinFormat(style)
    If WSend(state.Entry, 1092, 1, CType(data.DataPtr(), Integer)) = 0 Then Throw New Exception("Could not set Rich Edit typing format")
End Sub
Private Sub RichNativeRender(state As RichState, document As StyledText)
    Dim offsets As Array Of Integer = RichOffsets(document.PlainText())
    RichWinSetRange(state.Entry, 0, offsets(document.Length()))
    Dim paragraph As Bytes = RichWinBuffer(188)
    RichLittle(paragraph, 0, 188)
    RichLittle(paragraph, 4, 511)
    paragraph.SetItem(24, 1)
    If WSend(state.Entry, 1095, 0, CType(paragraph.DataPtr(), Integer)) = 0 Then Throw New Exception("Could not reset Rich Edit paragraph format")
    For Each run As StyleRun In document.Runs()
        RichWinSetRange(state.Entry, offsets(run.Start), offsets(run.Start + run.Length))
        Dim data As Bytes = RichWinFormat(run.Style)
        If WSend(state.Entry, 1092, 1, CType(data.DataPtr(), Integer)) = 0 Then Throw New Exception("Could not style Rich Edit selection")
    Next
End Sub
Private Function RichWindowsState(id As Integer) As RichState
    Dim index As Integer = id - 1
    If index < 0 Or index >= Array.Count(RichRegistry.Items) Then Return Nil
    Return RichRegistry.Items(index).State
End Function
Private Function RichWindowsHost(widget As Ptr, message As UInt32, word As UInt64, param As Integer, id As Integer, data As UInt64) As Int64
    Dim owner As StyledTextEditor = RichGetOwner(CType(id, Ptr))
    Dim state As RichState = RichWindowsState(id)
    If message = 130 Then
        WUnsubclass(widget, AddressOf RichWindowsHost, id)
        If owner <> Nil Then owner.NativeDestroyed(widget)
        If state <> Nil Then
            state.Host = Nil
            state.Root = Nil
            state.Entry = Nil
            state.Buffer = Nil
        End If
    ElseIf owner <> Nil Then
        If message = 273 And CType(param, Ptr) = owner.TextHandle And (word >> 16) = 768 Then
            If state <> Nil And state.MessageDepth > 0 Then
                state.TextPending = True
            Else
                owner.NativeChanged(owner.TextHandle)
            End If
        End If
        If message = 78 And param <> 0 Then
            Dim header As RichWinHeader
            WHeader(header, CType(param, Ptr), 24)
            If header.Window = owner.TextHandle And header.Code = 1794 Then
                If state <> Nil And state.MessageDepth > 0 Then
                    state.SelectionPending = True
                Else
                    owner.NativeSelectionChanged(owner.TextHandle)
                End If
            End If
        End If
    End If
    Return WDefault(widget, message, word, param)
End Function
Private Function RichWindowsEntry(widget As Ptr, message As UInt32, word As UInt64, param As Integer, id As Integer, data As UInt64) As Int64
    Dim owner As StyledTextEditor = RichGetOwner(CType(id, Ptr))
    Dim state As RichState = RichWindowsState(id)
    If message = 130 Then
        WUnsubclass(widget, AddressOf RichWindowsEntry, id)
        If owner <> Nil Then owner.NativeDestroyed(widget)
        If state <> Nil Then
            If state.Entry = widget Then state.Entry = Nil
            If state.Root = widget Then state.Root = Nil
            If state.Buffer = widget Then state.Buffer = Nil
        End If
        Return WDefault(widget, message, word, param)
    End If
    If owner <> Nil Then
        If message = 258 And state <> Nil Then
            If word >= 55296 And word <= 56319 Then
                If Not owner.IsReadOnly Then state.PendingHigh = word
                Return 0
            ElseIf word >= 56320 And word <= 57343 Then
                If state.PendingHigh = 0 Or owner.IsReadOnly Then Return 0
                Dim pair As Bytes = RichWinBuffer(6)
                pair.SetItem(0, state.PendingHigh Mod 256)
                pair.SetItem(1, state.PendingHigh \ 256)
                pair.SetItem(2, word Mod 256)
                pair.SetItem(3, word \ 256)
                state.PendingHigh = 0
                WSend(widget, 194, 1, CType(pair.DataPtr(), Integer))
                Return 0
            Else
                state.PendingHigh = 0
            End If
        End If
        Dim control As Boolean = WKeyState(17) < 0
        If message = 256 And control And WKeyState(18) >= 0 Then
            If owner.NativeShortcut(word, WKeyState(16) < 0) Then Return 0
            If word = 86 Then
                WSend(widget, 770, 0, 0)
                Return 0
            End If
            ' Keep navigation, selection and clipboard; suppress native-only format commands.
            Select Case word
                Case 8, 33, 34, 35, 36, 37, 38, 39, 40, 45, 46
                Case 65, 67, 88
                    If WKeyState(16) < 0 Then Return 0
                Case 16, 17
                Case Else
                    Return 0
            End Select
        End If
        If message = 256 And word = 45 And WKeyState(16) < 0 Then
            WSend(widget, 770, 0, 0)
            Return 0
        End If
        If message = 258 And control And word <> 1 And word <> 3 And word <> 24 And word <> 8 And word <> 13 And word <> 127 Then Return 0
        If message = 256 And word = 46 Then owner.NativeWillReplaceSelection(False, True)
        If message = 258 Then owner.NativeWillReplaceSelection(word = 8, False)
        If message = 768 Or message = 770 Or message = 771 Or message = 194 Or message = 1088 Then owner.NativeWillReplaceSelection(False, False)
        If message = 770 Then
            Dim returned As Int64 = WSend(widget, 1088, 13, 0)
            If state Is Nil Or state.MessageDepth = 0 Then
                owner.NativeEditFinished()
                owner.NativeSelectionChanged(widget)
            End If
            Return returned
        End If
    End If
    If state <> Nil Then state.MessageDepth += 1
    Dim returned As Int64 = WDefault(widget, message, word, param)
    If state <> Nil Then state.MessageDepth -= 1
    ' Rich Edit notifies before its input operation finishes. Reconcile only
    ' after the outer WndProc returns; nested selection reads must not flush
    ' notifications against the old document or replace its typing attributes.
    If owner <> Nil And state <> Nil And state.MessageDepth = 0 And Not state.DrainingMessages Then
        state.DrainingMessages = True
        Try
            If state.TextPending Then
                state.TextPending = False
                owner.NativeChanged(widget)
            End If
            If state.SelectionPending Then
                state.SelectionPending = False
                owner.NativeSelectionChanged(widget)
            End If
        Finally
            state.DrainingMessages = False
        End Try
    End If
    If owner <> Nil Then
        If (state Is Nil Or state.MessageDepth = 0) And (message = 256 Or message = 257 Or message = 258 Or message = 514 Or message = 515 Or message = 768 Or message = 771 Or message = 194 Or message = 1088) Then
            owner.NativeEditFinished()
            owner.NativeSelectionChanged(widget)
        End If
    End If
    Return returned
End Function
#End If
