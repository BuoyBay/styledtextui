Import styledtext

Private Class RichOwner
    Public Property Editor As Weak StyledTextEditor
    Public Property State As RichState
End Class
Private Class RichRegistry
    Public Shared Property Items As Array Of RichOwner = []
End Class
Private Class RichState
    Public Property ErrorSink As Weak StyledTextEditor
    Public Property CallbackDepth As Integer = 0
    Public Property MessageDepth As Integer = 0
    Public Property DrainingMessages As Boolean = False
    Public Property TextPending As Boolean = False
    Public Property SelectionPending As Boolean = False
    Public Property PendingHigh As Integer = 0
    Public Property Host As Ptr = Nil
    Public Property Root As Ptr = Nil
    Public Property Entry As Ptr = Nil
    Public Property Buffer As Ptr = Nil
    Public Property ID As Integer = -1
    Public Property Signals As Array Of UInt64 = []
    Public Property Tags As Array Of Ptr = []
    Public Property KeyController As Ptr = Nil
End Class
Private Class RichSelection
    Public Property Start As Integer = 0
    Public Property Length As Integer = 0
End Class
Private Class RichSnapshot
    Public Property Data As Bytes
    Public Property Start As Integer = 0
    Public Property Length As Integer = 0
    Public Property Typing As TextStyle
End Class

Private Function RichClone(document As StyledText) As StyledText
    If document Is Nil Then Throw New InvalidArgumentException("Document must not be Nil")
    Return StyledText.FromRuns(document.PlainText(), document.Runs(), document.DefaultStyle())
End Function
Private Sub RichValidateStyle(style As TextStyle)
    Dim checked As TextStyle = style.Copy()
    If checked.FontSize <> 0.0 And Not (checked.FontSize >= 1.0 And checked.FontSize <= 512.0) Then Throw New InvalidArgumentException("Editor font size must be zero or 1..512 points")
    If checked.FontName.AsUTF16LE().Count > 62 Then Throw New InvalidArgumentException("Editor font family must fit 31 UTF-16 units")
End Sub
Private Sub RichValidate(document As StyledText)
    If document.Length() > 100000 Then Throw New InvalidArgumentException("Editor content exceeds 100000 scalars")
    If String.Contains(document.PlainText(), "\r") Then Throw New InvalidArgumentException("Editor content requires LF newlines")
    RichValidateStyle(document.DefaultStyle())
    Dim runs As Array Of StyleRun = document.Runs()
    If Array.Count(runs) > 4096 Then Throw New InvalidArgumentException("Editor exceeds 4096 style runs")
    For Each run As StyleRun In runs
        RichValidateStyle(run.Style)
    Next
End Sub
Private Function RichOffsets(content As String) As Array Of Integer
    Dim offsets() As Integer
    Dim position As Integer = 0
    Array.Append(offsets, 0)
    For Each ch As String In String.Chars(content)
        position += 1
        If String.Asc(ch) > 65535 Then position += 1
        Array.Append(offsets, position)
    Next
    Return offsets
End Function
Private Function RichScalarAt(offsets As Array Of Integer, position As Integer) As Integer
    ' Native controls occasionally return a surrogate-interior caret. Reject it.
    Dim lo As Integer = 0
    Dim hi As Integer = Array.Count(offsets) - 1
    While lo <= hi
        Dim mid As Integer = (lo + hi) \ 2
        If offsets(mid) = position Then Return mid
        If offsets(mid) < position Then
            lo = mid + 1
        Else
            hi = mid - 1
        End If
    End While
    Throw New InvalidArgumentException("Native selection splits a Unicode scalar")
End Function
Private Sub RichCheckRange(document As StyledText, start As Integer, length As Integer)
    If start < 0 Or start > document.Length() Then Throw New InvalidArgumentException("Selection start out of bounds")
    If length < 0 Or length > document.Length() - start Then Throw New InvalidArgumentException("Selection length out of bounds")
End Sub
Private Function RichCaretStyle(document As StyledText, start As Integer, length As Integer) As TextStyle
    If document.Length() = 0 Then Return document.DefaultStyle()
    If length > 0 Or start = 0 Then Return document.StyleAt(start)
    Return document.StyleAt(start - 1)
End Function
Private Sub RichAppendRun(runs As Array Of StyleRun, start As Integer, length As Integer, style As TextStyle)
    If length = 0 Then Return
    Dim run As New StyleRun()
    run.Start = start
    run.Length = length
    run.Style = style
    Array.Append(runs, run)
End Sub

@MainThreadDestruction
''' Native rich-text editing. All operations belong to the UI thread; Open after attaching.
Public Class StyledTextEditor Inherits View
    Event DocumentChanged()
    Event SelectionChanged()
    Private Property mDocument As StyledText = New StyledText()
    Private Property mTyping As TextStyle = New TextStyle()
    Private Property mState As RichState
    Private Property mUpdating As Boolean = False
    Private Property mStart As Integer = 0
    Private Property mLength As Integer = 0
    Private Property mReadOnly As Boolean = False
    Private Property mEditStart As Integer = -1
    Private Property mEditLength As Integer = 0
    Private Property mGroupDepth As Integer = 0
    Private Property mGroupBefore As RichSnapshot
    Private Property mGroupChanged As Boolean = False
    Private Property mGroupMerge As Boolean = False
    Private Property mNativeKind As Integer = 0
    Private Property mNativeCaret As Integer = -1
    Private Property mNativeBefore As RichSnapshot
    Private Property mNativeStyle As TextStyle
    Private Property mUndo As Array Of RichSnapshot = []
    Private Property mRedo As Array Of RichSnapshot = []
    Public Property LastNativeError As String = ""

    Public Property Text As String
        Get
            Return mDocument.PlainText()
        End Get
        Set
            SetDocument(New StyledText(value, mDocument.DefaultStyle()))
        End Set
    End Property
    Public Property CharacterCount As Integer
        Get
            Return mDocument.Length()
        End Get
    End Property
    Public Property IsOpen As Boolean
        Get
            Return mState <> Nil And mState.Entry <> Nil
        End Get
    End Property
    Public Property TextHandle As Ptr
        Get
            If mState Is Nil Then Return Nil
            Return mState.Entry
        End Get
    End Property
    Public Property BufferHandle As Ptr
        Get
            If mState Is Nil Then Return Nil
            Return mState.Buffer
        End Get
    End Property
    Public Property IsReadOnly As Boolean
        Get
            Return mReadOnly
        End Get
        Set
            mReadOnly = value
            If IsOpen Then RichNativeEditable(mState, Not value)
        End Set
    End Property
    Public Property SelectionStart As Integer
        Get
            Return mStart
        End Get
    End Property
    Public Property SelectionLength As Integer
        Get
            Return mLength
        End Get
    End Property
    Public Property CanUndo As Boolean
        Get
            Return Array.Count(mUndo) > 0
        End Get
    End Property
    Public Property CanRedo As Boolean
        Get
            Return Array.Count(mRedo) > 0
        End Get
    End Property
    Public Function Document() As StyledText
        Return RichClone(mDocument)
    End Function
    Public Function TypingStyle() As TextStyle
        Return mTyping.Copy()
    End Function
    Public Function SelectedText() As String
        Return String.Substring(mDocument.PlainText(), mStart, mLength)
    End Function
    Public Sub SetDocument(document As StyledText)
        Dim copied As StyledText = RichClone(document)
        RichValidate(copied)
        Commit(copied, 0, 0, RichCaretStyle(copied, 0, 0), True)
        ClearHistory()
        RaiseEvent DocumentChanged()
    End Sub
    Public Sub Select(start As Integer, length As Integer)
        mNativeKind = 0
        RichCheckRange(mDocument, start, length)
        Dim typing As TextStyle = RichCaretStyle(mDocument, start, length)
        Commit(mDocument, start, length, typing, False)
        RaiseEvent SelectionChanged()
    End Sub
    Public Sub SetTypingStyle(style As TextStyle)
        mNativeKind = 0
        If style Is Nil Then Throw New InvalidArgumentException("Typing style must not be Nil")
        Dim copied As TextStyle = style.Copy()
        RichValidateStyle(copied)
        Commit(mDocument, mStart, mLength, copied, False)
    End Sub
    Public Sub ApplySelectionStyle(style As TextStyle)
        mNativeKind = 0
        If mReadOnly Then Return
        If style Is Nil Then Throw New InvalidArgumentException("Style must not be Nil")
        Dim copied As TextStyle = style.Copy()
        RichValidateStyle(copied)
        Dim nextDocument As StyledText = RichClone(mDocument)
        nextDocument.SetStyle(mStart, mLength, copied)
        RichValidate(nextDocument)
        Dim before As RichSnapshot = Snapshot()
        Commit(nextDocument, mStart, mLength, copied, False)
        Remember(before)
        RaiseEvent DocumentChanged()
    End Sub
    Public Sub SetSelectionBold(value As Boolean)
        SetSelectionFlag(1, value)
    End Sub
    Public Sub SetSelectionItalic(value As Boolean)
        SetSelectionFlag(2, value)
    End Sub
    Public Sub SetSelectionUnderline(value As Boolean)
        SetSelectionFlag(3, value)
    End Sub
    Private Sub SetSelectionFlag(kind As Integer, value As Boolean)
        mNativeKind = 0
        If mReadOnly Then Return
        Dim typing As TextStyle = mTyping.Copy()
        RichFlag(typing, kind, value)
        Dim runs() As StyleRun
        For Each run As StyleRun In mDocument.Runs()
            Dim low As Integer = Math.Max(run.Start, mStart)
            Dim high As Integer = Math.Min(run.Start + run.Length, mStart + mLength)
            If low >= high Then
                Array.Append(runs, run)
            Else
                RichAppendRun(runs, run.Start, low - run.Start, run.Style)
                Dim style As TextStyle = run.Style.Copy()
                RichFlag(style, kind, value)
                RichAppendRun(runs, low, high - low, style)
                RichAppendRun(runs, high, run.Start + run.Length - high, run.Style)
            End If
        Next
        Dim nextDocument As StyledText = StyledText.FromRuns(mDocument.PlainText(), runs, mDocument.DefaultStyle())
        RichValidate(nextDocument)
        Dim before As RichSnapshot = Snapshot()
        Commit(nextDocument, mStart, mLength, typing, False)
        Remember(before)
        RaiseEvent DocumentChanged()
    End Sub
    ''' Replace selected text with explicit typing attributes, preserving outside styles.
    Public Sub ReplaceSelection(content As String)
        mNativeKind = 0
        If mReadOnly Then Return
        If content = "" And mLength = 0 Then Return
        Dim insertion As New StyledText(content, mTyping)
        Dim nextDocument As StyledText = RichClone(mDocument)
        nextDocument.Delete(mStart, mLength)
        nextDocument.Insert(mStart, content, mTyping)
        RichValidate(nextDocument)
        Dim before As RichSnapshot = Snapshot()
        Dim caret As Integer = mStart + insertion.Length()
        Commit(nextDocument, caret, 0, mTyping, True)
        Remember(before)
        RaiseEvent DocumentChanged()
        RaiseEvent SelectionChanged()
    End Sub
    Private Sub CancelNativeGroup()
        mNativeKind = 0
        mNativeBefore = Nil
        mGroupBefore = Nil
        mGroupChanged = False
        mGroupMerge = False
    End Sub
    Public Sub ClearHistory()
        CancelNativeGroup()
        Array.Clear(mUndo)
        Array.Clear(mRedo)
    End Sub
    Public Sub Undo()
        FlushNativeGroup()
        mNativeKind = 0
        If mReadOnly Or Not CanUndo Then Return
        Dim target As RichSnapshot = mUndo(Array.Count(mUndo) - 1)
        Dim current As RichSnapshot = Snapshot()
        Commit(DecodeStyledText(target.Data), target.Start, target.Length, target.Typing, True)
        Array.RemoveAt(mUndo, Array.Count(mUndo) - 1)
        Array.Append(mRedo, current)
        TrimHistory()
        RaiseEvent DocumentChanged()
        RaiseEvent SelectionChanged()
    End Sub
    Public Sub Redo()
        FlushNativeGroup()
        mNativeKind = 0
        If mReadOnly Or Not CanRedo Then Return
        Dim target As RichSnapshot = mRedo(Array.Count(mRedo) - 1)
        Dim current As RichSnapshot = Snapshot()
        Commit(DecodeStyledText(target.Data), target.Start, target.Length, target.Typing, True)
        Array.RemoveAt(mRedo, Array.Count(mRedo) - 1)
        Array.Append(mUndo, current)
        TrimHistory()
        RaiseEvent DocumentChanged()
        RaiseEvent SelectionChanged()
    End Sub
    Private Function Snapshot() As RichSnapshot
        Dim saved As New RichSnapshot()
        saved.Data = EncodeStyledText(mDocument)
        saved.Start = mStart
        saved.Length = mLength
        saved.Typing = mTyping.Copy()
        Return saved
    End Function
    Private Sub Remember(saved As RichSnapshot)
        If mGroupDepth > 0 Then
            If mGroupBefore Is Nil Then mGroupBefore = saved
            mGroupChanged = True
            Return
        End If
        Array.Append(mUndo, saved)
        Array.Clear(mRedo)
        TrimHistory()
    End Sub
    Private Sub TrimHistory()
        Dim bytes As Integer = 0
        For Each item As RichSnapshot In mUndo
            bytes += item.Data.Count
        Next
        For Each item As RichSnapshot In mRedo
            bytes += item.Data.Count
        Next
        While bytes > 8000000 Or Array.Count(mUndo) + Array.Count(mRedo) > 100
            If Array.Count(mUndo) > 0 Then
                bytes -= mUndo(0).Data.Count
                Array.RemoveAt(mUndo, 0)
            Else
                bytes -= mRedo(0).Data.Count
                Array.RemoveAt(mRedo, 0)
            End If
        End While
    End Sub
    Private Sub Commit(document As StyledText, start As Integer, length As Integer, typing As TextStyle, writeContent As Boolean)
        mUpdating = True
        Try
            If IsOpen Then
                If writeContent Then RichNativeWrite(mState, document.PlainText())
                RichNativeRender(mState, document)
                RichNativeSelect(mState, document.PlainText(), start, length)
                RichNativeTyping(mState, typing)
            End If
        Catch e As Exception
            Try
                If IsOpen Then
                    RichNativeWrite(mState, mDocument.PlainText())
                    RichNativeRender(mState, mDocument)
                    RichNativeSelect(mState, mDocument.PlainText(), mStart, mLength)
                    RichNativeTyping(mState, mTyping)
                End If
            Catch recovery As Exception
                mUpdating = False
                Throw recovery
            End Try
            ' BUI-015: a rethrow can bypass Finally on current toolchains.
            mUpdating = False
            Throw e
        Finally
            mUpdating = False
        End Try
        mDocument = document
        mStart = start
        mLength = length
        mTyping = typing.Copy()
    End Sub
    Public Sub Open()
        If IsOpen Then Return
        If mState <> Nil Then Close()
        If NativeWidget = Nil Then Throw New InvalidArgumentException("Attach StyledTextEditor before Open")
        Dim state As New RichState()
        state.Host = NativeWidget
        For i As Integer = 0 To Array.Count(RichRegistry.Items) - 1
            If RichRegistry.Items(i).Editor Is Nil And RichRegistry.Items(i).State Is Nil Then
                state.ID = i
                Exit For
            End If
        Next
        If state.ID < 0 Then
            If Array.Count(RichRegistry.Items) >= 256 Then Throw New InvalidArgumentException("Too many open styled editors")
            state.ID = Array.Count(RichRegistry.Items)
            Array.Append(RichRegistry.Items, New RichOwner())
        End If
        mState = state
        RichRegistry.Items(state.ID).Editor = Me
        RichRegistry.Items(state.ID).State = state
        mUpdating = True
        Try
            RichNativeOpen(state)
            RefreshNative()
            RichNativeEditable(state, Not mReadOnly)
            Commit(mDocument, mStart, mLength, mTyping, True)
            LastNativeError = ""
        Catch e As Exception
            mUpdating = False
            Close()
            Throw e
        Finally
            mUpdating = False
        End Try
    End Sub
    Public Sub RefreshNative()
        If IsOpen Then RichNativeSize(mState, Width, Height)
    End Sub
    Public Sub FocusEditor()
        If IsOpen Then RichNativeFocus(mState)
    End Sub
    Public Sub Close()
        If mState Is Nil Then Return
        Dim state As RichState = mState
        NativeEditFinished()
        FlushNativeGroup()
        CancelNativeGroup()
        mState = Nil
        If state.CallbackDepth > 0 Then state.ErrorSink = Me
        If state.ID >= 0 Then RichRegistry.Items(state.ID).Editor = Nil
        mUpdating = True
        Try
            RichNativeClose(state)
        Finally
            mUpdating = False
        End Try
    End Sub
    Public Sub Destructor()
        Close()
    End Sub
    ''' Callback entry; native callbacks never unwind a Buoy exception into C.
    Public Function NativeUpdating() As Boolean
        Return mUpdating
    End Function
    Public Sub NativeBeginAction()
        If mUpdating Or Not IsOpen Then Return
        Try
            If mGroupDepth = 0 Then
                mGroupBefore = Snapshot()
                mGroupChanged = False
                mGroupMerge = False
            End If
            mGroupDepth += 1
        Catch e As Exception
            LastNativeError = e.Message
        End Try
    End Sub
    Public Sub NativeEndAction()
        If mUpdating Or mGroupDepth = 0 Then Return
        mGroupDepth -= 1
        If mGroupDepth = 0 Then
            Try
                If mGroupChanged And Not mGroupMerge And mGroupBefore <> Nil Then Remember(mGroupBefore)
            Catch e As Exception
                LastNativeError = "Native history: " + e.Message
            Finally
                mGroupBefore = Nil
                mGroupChanged = False
                mGroupMerge = False
            End Try
        End If
    End Sub
    Private Sub FlushNativeGroup()
        If mGroupDepth = 0 Then Return
        mGroupDepth = 1
        NativeEndAction()
    End Sub
    Private Sub RememberNative(before As RichSnapshot, start As Integer, removed As Integer, inserted As String)
        Dim kind As Integer = 0
        If removed = 0 And inserted <> "" Then kind = 1
        If inserted = "" And removed > 0 Then
            If before.Length > 0 Then
                kind = 4
            ElseIf start < before.Start Then
                kind = 2
            Else
                kind = 3
            End If
        End If
        Dim merge As Boolean = False
        If mNativeStyle <> Nil And mNativeBefore <> Nil And mNativeStyle.Equals(mTyping) Then
            If kind = 1 And (mNativeKind = 1 Or mNativeKind = 4) And start = mNativeCaret Then merge = True
            If kind = 2 And mNativeKind = 2 And start + removed = mNativeCaret Then merge = True
            If kind = 3 And mNativeKind = 3 And start = mNativeCaret Then merge = True
        End If
        If mGroupDepth > 0 Then
            If Not mGroupChanged Then mGroupMerge = merge
            Remember(before)
        ElseIf Not merge Then
            Remember(before)
        End If
        Array.Clear(mRedo)
        If Not merge Then mNativeBefore = before
        mNativeStyle = mTyping.Copy()
        mNativeCaret = mStart
        mNativeKind = kind
        ' Whitespace closes a typing burst; explicit commands/caret moves do too.
        If String.Contains(inserted, " ") Or String.Contains(inserted, "\n") Or String.Contains(inserted, "\t") Then mNativeKind = 0
    End Sub
    Public Sub NativeRejectEdit()
        If mUpdating Or Not IsOpen Then Return
        Dim saved As RichSnapshot = Nil
        If mGroupChanged Then saved = mGroupBefore
        If saved Is Nil And mNativeKind = 4 Then
            saved = mNativeBefore
            If Array.Count(mUndo) > 0 Then Array.RemoveAt(mUndo, Array.Count(mUndo) - 1)
        End If
        If saved Is Nil Then Return
        Commit(DecodeStyledText(saved.Data), saved.Start, saved.Length, saved.Typing, True)
        CancelNativeGroup()
    End Sub
    Public Sub NativeNormalizedEdit(start As Integer, length As Integer, content As String)
        Dim active As RichState = mState
        If active Is Nil Then Return
        active.CallbackDepth += 1
        Try
            If Not NativeAcceptEdit(start, length, content) Then
                NativeRejectEdit()
                Return
            End If
            Dim before As RichSnapshot = Snapshot()
            Dim nextDocument As StyledText = RichClone(mDocument)
            nextDocument.Delete(start, length)
            nextDocument.Insert(start, content, mTyping)
            Commit(nextDocument, start + String.Len(content), 0, mTyping, True)
            RememberNative(before, start, length, content)
            RaiseEvent DocumentChanged()
            RaiseEvent SelectionChanged()
        Catch e As Exception
            LastNativeError = e.Message
        Finally
            RichCallbackFinished(active)
        End Try
    End Sub
    Public Function NativeAcceptEdit(start As Integer, length As Integer, content As String) As Boolean
        If mUpdating Then Return True
        If mReadOnly Or Not IsOpen Then Return False
        Try
            Dim inserted As New StyledText(content, mTyping)
            Dim nextDocument As StyledText = RichClone(mDocument)
            nextDocument.Delete(start, length)
            nextDocument.Insert(start, content, mTyping)
            RichValidate(nextDocument)
            Return True
        Catch e As Exception
            LastNativeError = e.Message
            Return False
        End Try
    End Function
    Public Sub NativeWillReplaceSelection(backspace As Boolean, forwardDelete As Boolean)
        If mUpdating Or Not IsOpen Then Return
        Try
            Dim selection As RichSelection = RichNativeSelection(mState, mDocument.PlainText())
            RichCheckRange(mDocument, selection.Start, selection.Length)
            mStart = selection.Start
            mLength = selection.Length
            Dim start As Integer = selection.Start
            Dim length As Integer = selection.Length
            If length = 0 Then
                If backspace And start > 0 Then
                    start -= 1
                    length = 1
                ElseIf forwardDelete And start < mDocument.Length() Then
                    length = 1
                End If
            End If
            NativeWillEdit(start, length)
        Catch e As Exception
            LastNativeError = e.Message
        End Try
    End Sub
    Public Sub NativeWillEdit(start As Integer, length As Integer)
        If mUpdating Or Not IsOpen Then Return
        RichCheckRange(mDocument, start, length)
        mEditStart = start
        mEditLength = length
    End Sub
    Public Sub NativeEditFinished()
        mEditStart = -1
        mEditLength = 0
    End Sub
    Public Sub NativeChanged(widget As Ptr)
        If Not IsOpen Or mUpdating Or widget <> mState.Entry Then Return
        Dim activeState As RichState = mState
        Dim oldStart As Integer = mStart
        Dim oldLength As Integer = mLength
        If activeState <> Nil Then activeState.CallbackDepth += 1
        Try
        Try
            If mReadOnly Then
                Commit(mDocument, mStart, mLength, mTyping, True)
                Return
            End If
            Dim editStart As Integer = mEditStart
            Dim editLength As Integer = mEditLength
            NativeEditFinished()
            Dim content As String = RichNativeRead(mState)
            Dim sameText As Boolean = String.Compare(content, mDocument.PlainText(), True) = 0
            If sameText And (editStart < 0 Or editLength = 0) Then Return
            Dim checked As New StyledText(content)
            If checked.Length() > 100000 Then Throw New InvalidArgumentException("Editor content exceeds 100000 scalars")
            Dim oldChars As Array Of String = String.Chars(mDocument.PlainText())
            Dim newChars As Array Of String = String.Chars(content)
            Dim prefix As Integer = 0
            Dim oldCount As Integer = Array.Count(oldChars)
            Dim newCount As Integer = Array.Count(newChars)
            Dim selection As RichSelection = RichNativeSelection(mState, content)
            #If TargetWindows Then
                ' Rich Edit word/backspace commands may delete more than one scalar.
                ' Once its WndProc returns, the collapsed caret identifies pure deletion.
                If mLength = 0 And newCount < oldCount And selection.Length = 0 Then
                    editStart = selection.Start
                    editLength = oldCount - newCount
                End If
            #End If
            Dim prefixLimit As Integer = Math.Min(oldCount, newCount)
            If editStart >= 0 Then prefixLimit = Math.Min(prefixLimit, editStart)
            While prefix < prefixLimit
                If String.Compare(oldChars(prefix), newChars(prefix), True) <> 0 Then Exit While
                prefix += 1
            End While
            Dim suffix As Integer = 0
            Dim suffixLimit As Integer = Math.Min(oldCount, newCount) - prefix
            If editStart >= 0 Then suffixLimit = Math.Min(suffixLimit, oldCount - editStart - editLength)
            While suffix < suffixLimit
                If String.Compare(oldChars(oldCount - suffix - 1), newChars(newCount - suffix - 1), True) <> 0 Then Exit While
                suffix += 1
            End While
            Dim nextDocument As StyledText = RichClone(mDocument)
            nextDocument.Delete(prefix, oldCount - prefix - suffix)
            nextDocument.Insert(prefix, String.Substring(content, prefix, newCount - prefix - suffix), mTyping)
            RichValidate(nextDocument)
            RichCheckRange(nextDocument, selection.Start, selection.Length)
            Dim before As RichSnapshot = Snapshot()
            Commit(nextDocument, selection.Start, selection.Length, mTyping, False)
            RememberNative(before, prefix, oldCount - prefix - suffix, String.Substring(content, prefix, newCount - prefix - suffix))
        Catch e As Exception
            LastNativeError = e.Message
            Try
                Commit(mDocument, mStart, mLength, mTyping, True)
            Catch recovery As Exception
                LastNativeError += "; recovery: " + recovery.Message
            End Try
            Return
        End Try
        Try
            RaiseEvent DocumentChanged()
            If oldStart <> mStart Or oldLength <> mLength Then RaiseEvent SelectionChanged()
        Catch e As Exception
            LastNativeError = e.Message
        End Try
        Finally
            If activeState <> Nil Then RichCallbackFinished(activeState)
        End Try
    End Sub
    Public Sub NativeSelectionChanged(widget As Ptr)
        If Not IsOpen Or mUpdating Or mEditStart >= 0 Or widget <> mState.Entry Then Return
        Dim activeState As RichState = mState
        If activeState <> Nil Then activeState.CallbackDepth += 1
        Try
        Try
            Dim selection As RichSelection = RichNativeSelection(mState, mDocument.PlainText())
            RichCheckRange(mDocument, selection.Start, selection.Length)
            If selection.Start = mStart And selection.Length = mLength Then Return
            mNativeKind = 0
            mStart = selection.Start
            mLength = selection.Length
            mTyping = RichCaretStyle(mDocument, mStart, mLength)
            RaiseEvent SelectionChanged()
        Catch e As Exception
            LastNativeError = e.Message
        End Try
        Finally
            If activeState <> Nil Then RichCallbackFinished(activeState)
        End Try
    End Sub
    Public Function NativeShortcut(key As Integer, shift As Boolean) As Boolean
        Dim activeState As RichState = mState
        If activeState <> Nil Then activeState.CallbackDepth += 1
        Try
        Try
            #If TargetWindows Then
                If key >= 97 Then Return False
            #End If
            Select Case key
                Case 66, 98
                    SetSelectionBold(Not mTyping.Bold)
                Case 73, 105
                    SetSelectionItalic(Not mTyping.Italic)
                Case 85, 117
                    SetSelectionUnderline(Not mTyping.Underline)
                Case 90, 122
                    If shift Then
                        Redo()
                    Else
                        Undo()
                    End If
                Case 89, 121
                    Redo()
                Case Else
                    Return False
            End Select
        Catch e As Exception
            LastNativeError = e.Message
        End Try
        Return True
        Finally
            If activeState <> Nil Then RichCallbackFinished(activeState)
        End Try
    End Function
    Public Sub NativeDestroyed(widget As Ptr)
        If mState Is Nil Then Return
        If widget = mState.Entry Then mState.Entry = Nil
        If widget = mState.Host Then
            RichRegistry.Items(mState.ID).Editor = Nil
            mState.Host = Nil
            mState.Root = Nil
            mState.Entry = Nil
        End If
    End Sub
End Class

Private Class RichPendingCleanup
    Public Shared Property States As Array Of RichState = []
    Public Shared Property Scheduled As Boolean = False
End Class
Private Sub RichDispose(state As RichState)
    RichNativeDispose(state)
    If state.ID >= 0 Then
        If RichRegistry.Items(state.ID).State Is state Then RichRegistry.Items(state.ID).State = Nil
    End If
End Sub
Private Sub RichCallbackFinished(state As RichState)
    state.CallbackDepth -= 1
    If state.CallbackDepth = 0 And Array.Count(RichPendingCleanup.States) > 0 And Not RichPendingCleanup.Scheduled Then
        RichPendingCleanup.Scheduled = True
        Try
            RichNativeScheduleCleanup()
        Catch e As Exception
            RichPendingCleanup.Scheduled = False
            Dim owner As StyledTextEditor = state.ErrorSink
            If owner <> Nil Then owner.LastNativeError = "Deferred cleanup scheduling: " + e.Message
        End Try
    End If
End Sub
Private Sub RichDrainClosed()
    RichPendingCleanup.Scheduled = False
    Dim pending As Array Of RichState = RichPendingCleanup.States
    RichPendingCleanup.States = []
    For Each state As RichState In pending
        If state.CallbackDepth > 0 Then
            Array.Append(RichPendingCleanup.States, state)
            Continue For
        End If
        Try
            RichDispose(state)
        Catch e As Exception
            ' Keep a failed slot reserved; never reuse live callback identities.
            Dim owner As StyledTextEditor = state.ErrorSink
            If owner <> Nil Then owner.LastNativeError = "Deferred native cleanup: " + e.Message
        End Try
    Next
End Sub
Private Sub RichNativeClose(state As RichState)
    If state.CallbackDepth > 0 Then
        Array.Append(RichPendingCleanup.States, state)
        If Not RichPendingCleanup.Scheduled Then
            RichPendingCleanup.Scheduled = True
            Try
                RichNativeScheduleCleanup()
            Catch e As Exception
                RichPendingCleanup.Scheduled = False
                Dim owner As StyledTextEditor = state.ErrorSink
                If owner <> Nil Then owner.LastNativeError = "Deferred cleanup scheduling: " + e.Message
                ' Callback exit retries; keep the native object alive meanwhile.
            End Try
        End If
    Else
        RichDispose(state)
    End If
End Sub

Private Sub RichFlag(style As TextStyle, kind As Integer, value As Boolean)
    If kind = 1 Then style.Bold = value
    If kind = 2 Then style.Italic = value
    If kind = 3 Then style.Underline = value
End Sub
Private Function RichGetOwner(id As Ptr) As StyledTextEditor
    Dim index As Integer = CType(id, Integer) - 1
    If index < 0 Or index >= Array.Count(RichRegistry.Items) Then Return Nil
    Return RichRegistry.Items(index).Editor
End Function

#If TargetLinux Then
Private Class RichGTKEditIters
    Public Property Buffer As Ptr
    Public Property First As Ptr
    Public Property Last As Ptr
    Public Shared Property Active As Array Of RichGTKEditIters = []
End Class
Private Sub RichGTKTrack(buffer As Ptr, first As Ptr, last As Ptr)
    Dim item As New RichGTKEditIters()
    item.Buffer = buffer
    item.First = first
    item.Last = last
    Array.Append(RichGTKEditIters.Active, item)
End Sub
Private Sub RichGTKUntrack(first As Ptr)
    For i As Integer = Array.Count(RichGTKEditIters.Active) - 1 To 0 Step -1
        If RichGTKEditIters.Active(i).First = first Then
            Array.RemoveAt(RichGTKEditIters.Active, i)
            Return
        End If
    Next
End Sub
Sequential Structure RichIter
    A0 As Int64
    A1 As Int64
    A2 As Int64
    A3 As Int64
    A4 As Int64
    A5 As Int64
    A6 As Int64
    A7 As Int64
    A8 As Int64
    A9 As Int64
    A10 As Int64
    A11 As Int64
End Structure
Sequential Structure RichGValue
    TypeID As UInt64
    A As UInt64
    B As UInt64
End Structure
Sequential Structure RichRGBA
    Red As Single
    Green As Single
    Blue As Single
    Alpha As Single
End Structure
