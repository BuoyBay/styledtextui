Private Delegate Function RichGTKIdle(data As Ptr) As Int32
Private Optional Declare Function RIdle Lib "libglib-2.0.so.0" Alias "g_idle_add_full" (priority As Int32, callback As RichGTKIdle, data As Ptr, destroy As Ptr) As UInt32
Private Sub RichNativeScheduleCleanup()
    If RIdle(0, AddressOf RichGTKDrain, Nil, Nil) = 0 Then Throw New Exception("Could not schedule GTK editor cleanup")
End Sub
Private Function RichGTKDrain(data As Ptr) As Int32
    RichDrainClosed()
    Return 0
End Function

Private Sub RichNativeOpen(state As RichState)
    state.Root = RScrollNew()
    If state.Root = Nil Then Throw New Exception("Could not create GTK scroll view")
    RRefSink(state.Root)
    state.Entry = RTextNew()
    If state.Entry = Nil Then Throw New Exception("Could not create GTK text view")
    Dim css As Ptr = RCSSNew()
    If css = Nil Then Throw New Exception("Could not create editor appearance")
    RCSSLoad(css, "textview, textview text { background-color: white; color: black; }", -1)
    RAddProvider(RStyleContext(state.Entry), css, 800)
    RUnref(css)
    RScrollChild(state.Root, state.Entry)
    RPut(state.Host, state.Root, 0.0, 0.0)
    RWrap(state.Entry, 3)
    state.Buffer = RBuffer(state.Entry)
    RUndoEnabled(state.Buffer, 0)
    Dim changed As RichGTKCallback = AddressOf RichGTKChanged
    Dim marked As RichGTKMarkCallback = AddressOf RichGTKMarked
    Dim insertBefore As RichGTKInsertCallback = AddressOf RichGTKInserting
    Dim insertAfter As RichGTKInsertCallback = AddressOf RichGTKInserted
    Dim deleteBefore As RichGTKDeleteCallback = AddressOf RichGTKDeleting
    Dim deleteAfter As RichGTKDeleteCallback = AddressOf RichGTKDeleted
    Array.Append(state.Signals, RConnect(state.Buffer, "changed", CType(changed, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    Array.Append(state.Signals, RConnect(state.Buffer, "mark-set", CType(marked, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    Array.Append(state.Signals, RConnect(state.Buffer, "insert-text", CType(insertBefore, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    Array.Append(state.Signals, RConnect(state.Buffer, "insert-text", CType(insertAfter, Ptr), CType(state.ID + 1, Ptr), Nil, 1))
    Array.Append(state.Signals, RConnect(state.Buffer, "delete-range", CType(deleteBefore, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    Array.Append(state.Signals, RConnect(state.Buffer, "delete-range", CType(deleteAfter, Ptr), CType(state.ID + 1, Ptr), Nil, 1))
    Dim beginAction As RichGTKCallback = AddressOf RichGTKBegin
    Dim endAction As RichGTKCallback = AddressOf RichGTKEnd
    Array.Append(state.Signals, RConnect(state.Buffer, "begin-user-action", CType(beginAction, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    Array.Append(state.Signals, RConnect(state.Buffer, "end-user-action", CType(endAction, Ptr), CType(state.ID + 1, Ptr), Nil, 0))
    state.KeyController = RKeyController()
    RControllerPhase(state.KeyController, 1)
    Dim key As RichGTKKeyCallback = AddressOf RichGTKKey
    RConnect(state.KeyController, "key-pressed", CType(key, Ptr), CType(state.ID + 1, Ptr), Nil, 0)
    RAddController(state.Entry, state.KeyController)
End Sub
Private Sub RichNativeDispose(state As RichState)
    If state.Buffer <> Nil Then
        For Each id As UInt64 In state.Signals
            RDisconnect(state.Buffer, id)
        Next
        RichClearTags(state)
    End If
    If state.Root <> Nil Then
        Dim parent As Ptr = RParent(state.Root)
        If parent <> Nil Then RRemove(parent, state.Root)
        RUnref(state.Root)
    End If
    state.Root = Nil
    state.Entry = Nil
    state.Buffer = Nil
End Sub
Private Sub RichNativeSize(state As RichState, width As Integer, height As Integer)
    RSize(state.Root, Math.Max(1, width), Math.Max(1, height))
End Sub
Private Sub RichNativeFocus(state As RichState)
    RFocus(state.Entry)
End Sub
Private Sub RichNativeEditable(state As RichState, enabled As Boolean)
    Dim native As Int32 = 0
    If enabled Then native = 1
    REditable(state.Entry, native)
End Sub
Private Function RichNativeRead(state As RichState) As String
    Dim count As Integer = RCharCount(state.Buffer)
    If count > 100000 Then Throw New InvalidArgumentException("Native text exceeds editor limit")
    Dim first As RichIter
    Dim last As RichIter
    RBounds(state.Buffer, first, last)
    Dim data As CString = RGetText(state.Buffer, first, last, 1)
    Dim content As String = CType(data, String)
    RFree(CType(data, Ptr))
    If String.Len(content) <> count Then Throw New InvalidArgumentException("Native content contains an unsupported scalar")
    Return content
End Function
Private Sub RichNativeWrite(state As RichState, content As String)
    RSetText(state.Buffer, content, String.LenBytes(content))
End Sub
Private Function RichNativeSelection(state As RichState, content As String) As RichSelection
    Dim first As RichIter
    Dim last As RichIter
    RSelection(state.Buffer, first, last)
    Dim selection As New RichSelection()
    selection.Start = ROffset(first)
    selection.Length = ROffset(last) - selection.Start
    Return selection
End Function
Private Sub RichNativeSelect(state As RichState, content As String, start As Integer, length As Integer)
    Dim first As RichIter
    Dim last As RichIter
    RAt(state.Buffer, first, start)
    RAt(state.Buffer, last, start + length)
    RSelect(state.Buffer, last, first)
End Sub
Private Sub RichNativeTyping(state As RichState, style As TextStyle)
    ' GTK insertion attributes are applied by the bounded model reconciliation.
End Sub
Private Sub RichClearTags(state As RichState)
    Dim table As Ptr = RTagTable(state.Buffer)
    For Each tag As Ptr In state.Tags
        RTagRemove(table, tag)
        RUnref(tag)
    Next
    Array.Clear(state.Tags)
End Sub
Private Sub RichNativeRender(state As RichState, document As StyledText)
    Dim first As RichIter
    Dim last As RichIter
    RBounds(state.Buffer, first, last)
    RRemoveTags(state.Buffer, first, last)
    RichClearTags(state)
    For Each run As StyleRun In document.Runs()
        Dim tag As Ptr = RTagNew(Nil)
        If tag = Nil Then Throw New Exception("Could not allocate GTK style tag")
        If RTagAdd(RTagTable(state.Buffer), tag) = 0 Then
            RUnref(tag)
            Throw New Exception("Could not register GTK style tag")
        End If
        Array.Append(state.Tags, tag)
        Dim font As Ptr = RFontNew()
        If font = Nil Then Throw New Exception("Could not allocate font description")
        Try
            If run.Style.FontName <> "" Then RFontFamily(font, run.Style.FontName)
            Dim size As Double = run.Style.FontSize
            If size = 0.0 Then size = 12.0
            RFontSize(font, size * 1024.0 + 0.5)
            Dim weight As Int32 = 400
            If run.Style.Bold Then weight = 700
            RFontWeight(font, weight)
            Dim slant As Int32 = 0
            If run.Style.Italic Then slant = 2
            RFontStyle(font, slant)
            Dim value As RichGValue
            RValueInit(value, RFontType())
            RValueBoxed(value, font)
            RSetProperty(tag, "font-desc", value)
            RValueUnset(value)
            RValueInit(value, RUnderlineType())
            Dim underline As Int32 = 0
            If run.Style.Underline Then underline = 1
            RValueInt(value, underline)
            RSetProperty(tag, "underline", value)
            RValueUnset(value)
            Dim color As RichRGBA
            color.Red = run.Style.Red / 65535.0
            color.Green = run.Style.Green / 65535.0
            color.Blue = run.Style.Blue / 65535.0
            color.Alpha = 1.0
            RValueInit(value, RColorType())
            RValueColor(value, color)
            RSetProperty(tag, "foreground-rgba", value)
            RValueUnset(value)
        Finally
            RFontFree(font)
        End Try
        RAt(state.Buffer, first, run.Start)
        RAt(state.Buffer, last, run.Start + run.Length)
        RApplyTag(state.Buffer, tag, first, last)
    Next
End Sub
Private Sub RichGTKBegin(buffer As Ptr, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner <> Nil Then owner.NativeBeginAction()
End Sub
Private Sub RichGTKEnd(buffer As Ptr, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner <> Nil Then owner.NativeEndAction()
End Sub
Private Sub RichGTKChanged(buffer As Ptr, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner Is Nil Or owner.NativeUpdating() Then Return
    Dim state As RichState = RichRegistry.Items(CType(data, Integer) - 1).State
    Dim content As String = RichNativeRead(state)
    owner.NativeChanged(owner.TextHandle)
    If String.Compare(content, owner.Text, True) <> 0 Then
        ' A handler may replace the entire buffer during GTK's default edit.
        ' Revalidate its still-live iterators before the default handler resumes.
        For Each item As RichGTKEditIters In RichGTKEditIters.Active
            If item.Buffer = buffer Then
                RAtPointer(buffer, item.First, owner.SelectionStart)
                If item.Last <> Nil Then RAtPointer(buffer, item.Last, owner.SelectionStart)
            End If
        Next
    End If
End Sub
Private Sub RichGTKMarked(buffer As Ptr, iter As Ptr, mark As Ptr, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner <> Nil Then owner.NativeSelectionChanged(owner.TextHandle)
End Sub
Private Sub RichGTKInserting(buffer As Ptr, iter As Ptr, content As Ptr, length As Int32, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner Is Nil Or length = 0 Or owner.NativeUpdating() Then Return
    Try
        If length < 0 Or length > 400000 Then Throw New InvalidArgumentException("Native insertion exceeds byte limit")
        Dim bytes As New Bytes()
        bytes.Append(content, length)
        For i As Integer = 0 To bytes.Count - 1
            If bytes.Item(i) = 0 Then Throw New InvalidArgumentException("Native insertion contains NUL")
        Next
        Dim inserted As String = bytes.ToString(Text.Encodings.UTF8)
        If String.Contains(inserted, "\r") Then
            RStopSignal(buffer, "insert-text")
            inserted = String.Replace(String.Replace(inserted, "\r\n", "\n"), "\r", "\n")
            owner.NativeNormalizedEdit(ROffsetPtr(iter), 0, inserted)
            RAtPointer(buffer, iter, owner.SelectionStart)
            Return
        End If
        If Not owner.NativeAcceptEdit(ROffsetPtr(iter), 0, inserted) Then
            RStopSignal(buffer, "insert-text")
            owner.NativeRejectEdit()
            RAtPointer(buffer, iter, owner.SelectionStart)
            Return
        End If
        owner.NativeWillEdit(ROffsetPtr(iter), 0)
        RichGTKTrack(buffer, iter, Nil)
    Catch e As Exception
        owner.LastNativeError = e.Message
        RStopSignal(buffer, "insert-text")
        owner.NativeRejectEdit()
        RAtPointer(buffer, iter, owner.SelectionStart)
    End Try
End Sub
Private Sub RichGTKInserted(buffer As Ptr, iter As Ptr, content As Ptr, length As Int32, data As Ptr)
    RichGTKUntrack(iter)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner <> Nil Then owner.NativeEditFinished()
End Sub
Private Sub RichGTKDeleting(buffer As Ptr, first As Ptr, last As Ptr, data As Ptr)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner Is Nil Then Return
    If owner.NativeUpdating() Then Return
    Try
        Dim start As Integer = ROffsetPtr(first)
        Dim length As Integer = ROffsetPtr(last) - start
        If Not owner.NativeAcceptEdit(start, length, "") Then
            RStopSignal(buffer, "delete-range")
            Return
        End If
        owner.NativeWillEdit(start, length)
        RichGTKTrack(buffer, first, last)
    Catch e As Exception
        owner.LastNativeError = e.Message
        RStopSignal(buffer, "delete-range")
    End Try
End Sub
Private Sub RichGTKDeleted(buffer As Ptr, first As Ptr, last As Ptr, data As Ptr)
    RichGTKUntrack(first)
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner <> Nil Then owner.NativeEditFinished()
End Sub
Private Function RichGTKKey(controller As Ptr, keyval As UInt32, keycode As UInt32, modifiers As UInt32, data As Ptr) As Int32
    If (modifiers And 4) = 0 Or (modifiers And 8) <> 0 Then Return 0
    Dim owner As StyledTextEditor = RichGetOwner(data)
    If owner Is Nil Then Return 0
    If owner.NativeShortcut(keyval, (modifiers And 1) <> 0) Then Return 1
    Return 0
End Function
#End If

